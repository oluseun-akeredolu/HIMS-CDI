+def resource_gate_state(latency_p95, memory_peak, latency_limit=200.0, memory_limit=100.0):
+    """Classify scalar telemetry using strict limits and documented evidence precedence."""
+    def valid(value):
+        return (isinstance(value, Real) and not isinstance(value, (bool, np.bool_))
+                and math.isfinite(value) and value >= 0)
+
+    latency_valid = valid(latency_p95)
+    memory_valid = valid(memory_peak)
+    if (latency_valid and latency_p95 >= latency_limit) or (memory_valid and memory_peak >= memory_limit):
+        return 'FAIL'
+    if not (latency_valid and memory_valid):
+        return 'UNKNOWN'
+    return 'PASS'
+
